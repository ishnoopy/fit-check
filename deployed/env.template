# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Node Environment
NODE_ENV=production

# Frontend Configuration
API_URL=http://backend:4000

# Backend Configuration
FRONTEND_URL=https://fit-check.ishnoopy.space
BACKEND_PORT=4000

# Database (MongoDB Atlas connection string)
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fit-check?retryWrites=true&w=majority

# Redis (Upstash connection string)
REDIS_URL=rediss://:<password>@<host>.upstash.io:6379

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_secure_jwt_secret_here

# SSL/TLS Configuration
DOMAIN=fit-check.ishnoopy.space
EMAIL=ishnoopy@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://fit-check.ishnoopy.space/api/auth/google/callback

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# MinIO (object storage — AWS_ACCESS_KEY_ID/SECRET map to these credentials)
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_ENDPOINT=https://storage.fit-check.ishnoopy.space
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=tuff
